# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Database ---------------------------------------------------------------
# Neon POOLED connection string (the one with "-pooler" in the host).
# Neon, not Render Postgres: Render's free database is deleted 30 days after
# creation and this URL has to still resolve in May 2027.
# Must end with ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Socrata ----------------------------------------------------------------
# Optional but strongly recommended. Free, instant, no approval:
#   https://data.cityofnewyork.us/profile/edit/developer_settings
# Without it you share a throttling budget with every other anonymous caller
# and 429s become routine.
SOCRATA_APP_TOKEN=

SOCRATA_DOMAIN=data.cityofnewyork.us
SOCRATA_DATASET=erm2-nwe9

# --- Tuning -----------------------------------------------------------------
PAGE_SIZE=5000
MAX_PAGES_PER_RUN=40
RAW_RETENTION_DAYS=30
CLEAN_RETENTION_DAYS=60
DEDUP_WINDOW_MINUTES=60

# --- API --------------------------------------------------------------------
# In production set this to the deployed front-end origin, not *.
CORS_ORIGINS=*
